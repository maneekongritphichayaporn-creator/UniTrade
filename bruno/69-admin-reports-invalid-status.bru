meta {
  name: Admin reports - invalid status query
  type: http
  seq: 69
}

get {
  url: {{baseUrl}}/admin/reports?status=open
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

script:pre-request {
  // ข้ามเมื่อยังไม่มีบัญชี admin ใน bruno/.env (ไม่มี admin_token)
  if (!bru.getVar("admin_token")) {
    bru.runner.skipRequest();
  }
}


tests {
  test("422 VALIDATION_ERROR on field status", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().error.code).to.equal("VALIDATION_ERROR");
    expect(res.getBody().error.field).to.equal("status");
  });
}
