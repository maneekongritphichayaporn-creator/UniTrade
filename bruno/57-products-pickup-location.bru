meta {
  name: Products - pickup location
  type: http
  seq: 57
}

get {
  url: {{baseUrl}}/products?status=all&pickup_location=%E0%B8%A8%E0%B8%B2%E0%B8%A5%E0%B8%B2%E0%B8%9E%E0%B8%A3%E0%B8%B0%E0%B9%80%E0%B8%81%E0%B8%B5%E0%B9%89%E0%B8%A2%E0%B8%A7
  body: none
  auth: none
}

tests {
  test("200 and every item is picked up at ศาลาพระเกี้ยว", function () {
    expect(res.getStatus()).to.equal(200);
    for (const card of res.getBody().data) {
      expect(card.pickup_location).to.equal("ศาลาพระเกี้ยว");
    }
  });
}
