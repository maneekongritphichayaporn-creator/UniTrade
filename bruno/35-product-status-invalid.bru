meta {
  name: Product status - invalid value
  type: http
  seq: 35
}

patch {
  url: {{baseUrl}}/products/{{product_id}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "deleted"
  }
}

tests {
  test("422 INVALID_STATUS", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().error.code).to.equal("INVALID_STATUS");
    expect(res.getBody().error.field).to.equal("status");
  });
}
