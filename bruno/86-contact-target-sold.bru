meta {
  name: Contact target - mark sold
  type: http
  seq: 86
}

patch {
  url: {{baseUrl}}/products/{{contact_product_id}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "sold"
  }
}

tests {
  test("200 sold", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("sold");
  });
}
