meta {
  name: Report target - create product
  type: http
  seq: 42
}

post {
  url: {{baseUrl}}/products
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  title: ประกาศสำหรับทดสอบการรายงาน
  category_id: 00000000-0000-4000-8000-000000000001
  item_condition: good
  price: 100
  pickup_location: ศาลาพระเกี้ยว
  images: @file(fixtures/book.jpg)
}

script:post-response {
  const body = res.getBody();
  if (body && body.product_id) {
    bru.setVar("report_product_id", body.product_id);
  }
}

tests {
  test("201 product owned by the first user", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().product_id).to.be.a("string");
  });
}
