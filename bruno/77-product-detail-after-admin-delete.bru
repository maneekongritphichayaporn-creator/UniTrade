meta {
  name: Product detail - after admin delete
  type: http
  seq: 77
}

get {
  url: {{baseUrl}}/products/{{report_product_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

script:pre-request {
  // ข้ามเมื่อยังไม่มีบัญชี admin ใน bruno/.env (ไม่มี admin_token)
  if (!bru.getVar("admin_token")) {
    bru.runner.skipRequest();
  }
}


tests {
  test("200 with data [] (the post is gone)", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.eql([]);
  });
}
