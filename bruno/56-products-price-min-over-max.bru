meta {
  name: Products - min_price above max_price
  type: http
  seq: 56
}

get {
  url: {{baseUrl}}/products?min_price=500&max_price=100
  body: none
  auth: none
}

tests {
  test("422 VALIDATION_ERROR on field min_price", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().error.code).to.equal("VALIDATION_ERROR");
    expect(res.getBody().error.field).to.equal("min_price");
  });
}
