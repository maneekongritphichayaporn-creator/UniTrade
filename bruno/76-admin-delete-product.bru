meta {
  name: Admin delete product - success
  type: http
  seq: 76
}

delete {
  url: {{baseUrl}}/admin/products/{{report_product_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

script:pre-request {
  // ข้ามเมื่อยังไม่มีบัญชี admin ใน bruno/.env (ไม่มี admin_token)
  if (!bru.getVar("admin_token")) {
    bru.runner.skipRequest();
  }
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.setVar("admin_deleted", "yes");
  }
}

tests {
  test("204 a product created by Bruno removed by admin", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
