meta {
  name: Product create
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/products
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  title: CALCULUS I (2110101)
  category_id: 00000000-0000-4000-8000-000000000001
  item_condition: like_new
  price: 250
  pickup_location: ศาลาพระเกี้ยว
  images: @file(fixtures/book.jpg)
  images: @file(fixtures/book2.png)
}

script:post-response {
  const body = res.getBody();
  if (body && body.product_id) {
    bru.setVar("product_id", body.product_id);
  }
}

tests {
  test("201 with detail, two images, first one primary", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(201);
    expect(body.message).to.equal("ลงประกาศสำเร็จ");
    expect(body.is_owner).to.equal(true);
    expect(body.status).to.equal("available");
    expect(body.images.length).to.equal(2);
    expect(body.images[0].is_primary).to.equal(true);
    expect(body.images[1].is_primary).to.equal(false);
    expect(body.images.filter((img) => img.is_primary).length).to.equal(1);
    expect(body.seller).to.not.have.any.keys("phone_number", "line_id", "email", "password_hash");
  });
}
