meta {
  name: Login — INVALID_CREDENTIALS
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "WrongPassword99"
  }
}

tests {
  test("401 INVALID_CREDENTIALS", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error.code).to.equal("INVALID_CREDENTIALS");
  });
}
