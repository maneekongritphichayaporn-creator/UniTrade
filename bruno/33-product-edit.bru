meta {
  name: Product edit
  type: http
  seq: 33
}

patch {
  url: {{baseUrl}}/products/{{product_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "CALCULUS I (edited)",
    "price": 199.5,
    "status": "sold"
  }
}

tests {
  test("200 with edited fields, status is not editable here", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.title).to.equal("CALCULUS I (edited)");
    expect(body.price).to.equal(199.5);
    expect(body.status).to.equal("available");
  });
}
