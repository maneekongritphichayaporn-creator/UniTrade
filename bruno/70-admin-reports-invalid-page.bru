meta {
  name: Admin reports - invalid page query
  type: http
  seq: 70
}

get {
  url: {{baseUrl}}/admin/reports?page=0
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

script:pre-request {
  // ข้ามเมื่อยังไม่มีบัญชี admin ใน bruno/.env (ไม่มี admin_token)
  if (!bru.getVar("admin_token")) {
    bru.runner.skipRequest();
  }
}


tests {
  test("422 VALIDATION_ERROR on field page", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().error.code).to.equal("VALIDATION_ERROR");
    expect(res.getBody().error.field).to.equal("page");
  });
}
