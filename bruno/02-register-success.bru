meta {
  name: Register — success
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "UniTrade2026!",
    "full_name": "ผู้ทดสอบ บรูโน",
    "phone_number": "0812345678",
    "line_id": "bruno_test",
    "faculty": "คณะวิศวกรรมศาสตร์"
  }
}

script:pre-request {
  bru.setVar("email", `bruno.${Date.now()}@student.chula.ac.th`);
}

tests {
  test("201 with user and no password_hash", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().user.email).to.equal(bru.getVar("email"));
    expect(res.getBody().user).to.not.have.property("password_hash");
    expect(res.getBody().user.role).to.equal("member");
  });
}
