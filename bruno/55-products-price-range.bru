meta {
  name: Products - price range
  type: http
  seq: 55
}

get {
  url: {{baseUrl}}/products?status=all&min_price=100&max_price=500
  body: none
  auth: none
}

tests {
  test("200 and every price is between 100 and 500", function () {
    expect(res.getStatus()).to.equal(200);
    for (const card of res.getBody().data) {
      expect(card.price).to.be.within(100, 500);
    }
  });
}
