meta {
  name: Login — success
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "UniTrade2026!"
  }
}

script:post-response {
  bru.setVar("token", res.getBody().token);
}

tests {
  test("200 with 24h bearer token", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().token_type).to.equal("bearer");
    expect(res.getBody().expires_in).to.equal(86400);
    expect(res.getBody().user).to.not.have.property("password_hash");
  });
}
