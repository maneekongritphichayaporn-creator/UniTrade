meta {
  name: Admin reports - deleted product report is actioned
  type: http
  seq: 79
}

get {
  url: {{baseUrl}}/admin/reports?status=actioned
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

script:pre-request {
  // ข้ามเมื่อยังไม่มีบัญชี admin ใน bruno/.env (ไม่มี admin_token)
  if (!bru.getVar("admin_token")) {
    bru.runner.skipRequest();
  }
}


tests {
  test("200 the report of the deleted product is actioned with product null", function () {
    expect(res.getStatus()).to.equal(200);
    const mine = res.getBody().data.find((r) => r.report_id === bru.getVar("report_id"));
    expect(mine, "report from 47 is in the actioned list").to.be.an("object");
    expect(mine.status).to.equal("actioned");
    expect(mine.product).to.equal(null);
  });
}
