meta {
  name: Product status change
  type: http
  seq: 34
}

patch {
  url: {{baseUrl}}/products/{{product_id}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "reserved"
  }
}

tests {
  test("200 with the new status and message", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.product_id).to.equal(bru.getVar("product_id"));
    expect(body.status).to.equal("reserved");
    expect(body.message).to.equal("อัปเดตสถานะเป็น Reserved แล้ว");
  });
}
