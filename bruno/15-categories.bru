meta {
  name: Categories
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/categories
  body: none
  auth: none
}

tests {
  test("200 with 6 fixed categories in seed order", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.data.length).to.equal(6);
    expect(body.data[0].category_id).to.equal("00000000-0000-4000-8000-000000000001");
    expect(body.data[5].category_id).to.equal("00000000-0000-4000-8000-000000000006");
    expect(body.data[0].product_count).to.be.a("number");
  });
}