# คัดลอกเป็น .env.local แล้วใส่ค่าจริง — ห้าม commit .env.local
# ห้ามตั้งชื่อตัวแปรเหล่านี้ขึ้นต้นด้วย NEXT_PUBLIC_ (Next.js จะฝังลงโค้ดฝั่งเบราว์เซอร์)

SUPABASE_URL=https://kwvefqgipqagfqhibnjv.supabase.co
# Project Settings → API Keys: secret key (sb_secret_…) หรือ legacy service_role key
SUPABASE_SERVICE_ROLE_KEY=

# สุ่มใหม่ด้วย: openssl rand -base64 48 · ทุกเครื่องใน environment เดียวกันต้องใช้ค่าเดียวกัน
JWT_SECRET=

# ---------- ฝั่งหน้าเว็บ (frontend) ----------
# true = ใช้ข้อมูลจำลองใน lib/client/mock แทนการยิง /api/v1 จริง
# เอาไว้พัฒนา/เดโมหน้าเว็บตอนไม่มีคีย์ Supabase หรือตอน TASK-09 ยังไม่ merge
# ค่าว่างหรือไม่ใส่ = ยิง API จริง (ใช้ค่านี้บน Vercel)
NEXT_PUBLIC_USE_MOCK_API=
